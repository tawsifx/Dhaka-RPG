{
  "name": "dhaka-rpg",
  "version": "1.0.0",
  "description": "Totoro & Moon Walker: Chronicles of the Six Realms RPG & Telegram Automation Bridge",
  "main": "telegram-bot.js",
  "scripts": {
    "dev": "vite",
    "dev:race": "vite --open /race.html",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "validate:npc": "vitest run tests/npc/validator.test.ts",
    "assets:validate": "vitest run tests/combat/assets_validation.test.ts",
    "assets:report": "vitest run tests/combat/assets_validation.test.ts",
    "assets:compress": "python3 scripts/compress_images.py",
    "test:race": "vitest run tests/race/",
    "deploy:cf": "npm run build && wrangler pages deploy dist --project-name=moon-walkers-day --branch=main --commit-dirty=true",
    "start": "node telegram-bot.js",
    "bot": "caffeinate -s -i node telegram-bot.js"
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "node-telegram-bot-api": "^0.66.0",
    "phaser": "^3.87.0",
    "three": "^0.186.1",
    "three-mesh-bvh": "0.9.16"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/three": "^0.186.0",
    "playwright": "^1.64.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.1"
  }
}
