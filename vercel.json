{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "ignoreCommand": "exit 0",
  "buildCommand": "echo 'Vercel redirection active' && exit 0",
  "outputDirectory": ".",
  "routes": [
    {
      "src": "/(.*)",
      "status": 308,
      "headers": {
        "Location": "https://moon-walkers-day.pages.dev/$1",
        "Cache-Control": "public, max-age=31536000, immutable"
      }
    }
  ]
}
